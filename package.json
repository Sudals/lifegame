{
  "name": "grad-sim",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm run typecheck && pnpm --filter web build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.api.json && tsc -p tsconfig.e2e.json",
    "test:e2e": "tsx scripts/e2e-api.ts",
    "start": "tsx scripts/serve.ts",
    "test": "pnpm -r test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:smoke": "tsx scripts/db-smoke.ts"
  },
  "dependencies": {
    "@neon/config": "^1.10.1",
    "@neon/env": "^1.6.9",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.44.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@grad-sim/content": "workspace:^",
    "@grad-sim/engine": "workspace:^",
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.31.11",
    "playwright-core": "1.49.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3"
  }
}
